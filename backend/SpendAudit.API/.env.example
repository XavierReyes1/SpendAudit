# Copia este archivo a ".env" (que NO se sube a Git) y ajusta los valores.
# Doble guion bajo (__) = separador de secciones de configuración de .NET.

# Debe coincidir con infra/.env
ConnectionStrings__PostgresConnection=Host=localhost;Port=5432;Database=spendaudit;Username=spendaudit;Password=CAMBIAR_ESTA_CLAVE

# Mínimo 32 caracteres. Genera una con:  openssl rand -base64 48
Jwt__Key=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_AL_MENOS_32_CARACTERES

Cors__AllowedOrigins=http://localhost:5173
Database__MigrateOnStartup=false
